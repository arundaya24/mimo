APP_NAME=MIMO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# ========================================================
# DATABASE CONFIGURATION
# Default: MySQL (Sesuai spesifikasi proyek MIMO)
# Pastikan MySQL / XAMPP sudah berjalan di port 3306
# Buat database 'mimo' terlebih dahulu: CREATE DATABASE mimo;
# ========================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mimo
DB_USERNAME=root
DB_PASSWORD=

# Untuk pengujian instan tanpa setup MySQL (zero-config):
# Ubah DB_CONNECTION=sqlite dan jalankan php artisan migrate --seed

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=stack
LOG_LEVEL=debug
